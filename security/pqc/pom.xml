        </dependency>
        <dependency>
            <groupId>io.smallrye</groupId>
            <artifactId>smallrye-openssl</artifactId>
            <classifier>${smallrye.openssl.classifier}</classifier>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>aarch64</id>
            <properties>
                <smallrye.openssl.classifier>linux-aarch_64</smallrye.openssl.classifier>
            </properties>
